      "signals": ["line_level", "headphone_level"],
      "form": "y_lead",
      "notes": "Splits a stereo minijack into left and right on two 1/4\" plugs. One lead, two plugs at the far end."
    },
    {
      "id": "trs_quarter_y_ts_quarter",
      "name": "1/4\" TRS → 2 × 1/4\" TS Y-lead",
      "endA": { "connector": "trs_quarter", "gender": "male" },
      "endB": { "connector": "ts_quarter", "gender": "male" },
      "signals": ["line_level", "headphone_level"],
      "form": "y_lead",
      "notes": "Insert cable: splits a stereo-on-TRS jack into left and right on two 1/4\" plugs. One lead, two plugs at the far end."
    },
    {
      "id": "rca_ts_quarter",
