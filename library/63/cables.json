      "endB": { "connector": "trs_quarter", "gender": "male" },
      "signals": ["line_level", "headphone_level"],
      "notes": "Carries a stereo minijack whole onto a stereo-on-TRS jack, or a balanced mono signal between the two sizes."
    },
    {
      "id": "trs_eighth_y_ts_quarter",
