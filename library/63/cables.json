      "endB": { "connector": "ts_quarter", "gender": "male" },
      "signals": ["cv", "gate", "clock", "line_level", "instrument_level"],
      "notes": "Semi-modular patch point into a 1/4\" input."
    },
    {
      "id": "trs_eighth_to_quarter",
