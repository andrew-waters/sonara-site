{
  "cables": [
    {
      "id": "xlr_mic",
      "name": "XLR cable",
      "endA": { "connector": "xlr3", "gender": "female" },
      "endB": { "connector": "xlr3", "gender": "male" },
      "signals": ["mic_level", "line_level", "aes3"],
      "notes": "Balanced. Female end onto outputs, male end into inputs."
    },
    {
      "id": "trs_balanced",
      "name": "1/4\" TRS balanced cable",
      "endA": { "connector": "trs_quarter", "gender": "male" },
      "endB": { "connector": "trs_quarter", "gender": "male" },
      "signals": ["line_level", "headphone_level"]
    },
    {
      "id": "ts_instrument",
      "name": "1/4\" TS instrument cable",
      "endA": { "connector": "ts_quarter", "gender": "male" },
      "endB": { "connector": "ts_quarter", "gender": "male" },
      "signals": ["instrument_level", "line_level"],
      "notes": "Unbalanced; keep runs short for line-level use."
    },
    {
      "id": "xlrf_trs",
      "name": "XLR female → TRS cable",
      "endA": { "connector": "xlr3", "gender": "female" },
      "endB": { "connector": "trs_quarter", "gender": "male" },
      "signals": ["mic_level", "line_level"],
      "notes": "Balanced. XLR output into a TRS line input."
    },
    {
      "id": "trs_xlrm",
      "name": "TRS → XLR male cable",
      "endA": { "connector": "trs_quarter", "gender": "male" },
      "endB": { "connector": "xlr3", "gender": "male" },
      "signals": ["line_level"],
      "notes": "Balanced. TRS line output into an XLR input."
    },
    {
      "id": "patch_35",
      "name": "3.5mm patch cable",
